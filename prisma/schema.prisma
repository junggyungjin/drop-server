// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis] // PostGIS 확장 모듈 활성화
}

enum VoteType {
  LIKE
  DISLIKE
}

enum UserStatus {
  ACTIVE
  BANNED
  WITHDRAWN
}

model User {
  id         String     @id @default(uuid())
  provider   String     @default("google")
  providerId String     @map("provider_id")
  status     UserStatus @default(ACTIVE)

  nickname   String    @default("익명") @db.VarChar(50)

  drops      Drop[]
  comments   Comment[]
  votes      DropVote[]

  reports    Report[] @relation("Reporter")
  blocksSent Block[]  @relation("Blocker")
  blocksRecv Block[]  @relation("Blocked")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerId])
  @@map("users")
}

model Drop {
  id      String @id @default(uuid())
  content String @db.VarChar(500)

  // 위치 데이터
  latitude  Float // 위도
  longitude Float // 경도

  // 휘발성(Time-Bomb) 관리를 위한 만료 시각
  expiresAt DateTime @map("expires_at") // 글이 삭제 될 시간

  // 관계 선언 : "이 글을 쓴 유저 정보"
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // UI 렌더링 성능 최적화를 위한 카운트 캐싱
  likeCount    Int @default(0) @map("like_count")
  dislikeCount Int @default(0) @map("dislike_count")
  commentCount Int @default(0) @map("comment_count")

  // 생성 및 수정 시각
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comments  Comment[]
  dropVotes DropVote[]
  reports   Report[]

  @@index([expiresAt])  // 인덱스: 삭제될 시간이 지난 글을 DB에서 엄청 빨리 찾기 위한 책갈피
  @@index([authorId])
  @@map("drops")
}

model Comment {
  id       String @id @default(uuid())
  content  String @db.VarChar(200)
  dropId   String @map("drop_id")
  authorId String @map("author_id")

  // 원본 Drop 삭제 시 댓글 연쇄 삭제 (UX-03 자동 휘발성 동기화)
  drop   Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports Report[]

  @@index([dropId])
  @@map("comments")
}

model DropVote {
  id String @id @default(uuid())

  type VoteType

  dropId   String @map("drop_id")
  authorId String @map("author_id")

  drop   Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([dropId, authorId]) // 중복 투표 방지용 복합 유니크
  @@map("drop_votes")
}

model Report {
  id         String  @id @default(uuid())
  dropId     String? @map("drop_id") // 글 신고
  commentId  String? @map("comment_id") // 댓글 신고
  reporterId String  @map("reporter_id") // 신고자
  reason     String  @db.VarChar(100)

  reporter User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  drop     Drop?    @relation(fields: [dropId], references: [id], onDelete: SetNull)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model Block {
  id        String @id @default(uuid())
  blockerId String @map("blocker_id") // 차단한 사람
  blockedId String @map("blocked_id") // 차단당한 사람

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("blocks")
}
